  ngr_fct_program_telecast {
    bigint telecast_key FK
    string demo_code FK
    string stream_code FK
    int telecast_count
    int premiere_count
    decimal avg_audience_000
    decimal coverage_rating
    decimal gross_impressions_000
    string day_of_week_name
  }
  ngr_fct_reach_freq_timespent_month {
    int broadcast_month_key FK
    bigint network_key FK
    string demo_code FK
    bigint daypart_key FK
    string stream_code FK
    decimal reach_000 "from person-level data at this grain"
    decimal universe_000
    decimal reach_pct
    decimal avg_frequency_days
    decimal avg_time_spent_min
    int respondent_count
  }
  ngr_fct_universe_estimate_month {
    int broadcast_month_key FK
    bigint network_key FK
    string demo_code FK
    decimal ue_cov_000
    decimal ue_nat_000
  }
  ngr_fct_median_age_month {
    int broadcast_month_key FK
    bigint network_key FK
    bigint daypart_key FK
    string stream_code FK
    decimal median_age_p2 "interpolated over age bands"
  }
  ngr_fct_audience_profile_quarter {
    int broadcast_quarter_key FK
    bigint network_key FK
    boolean is_asc_benchmark
    bigint daypart_key FK
    string marketbreak "23 attributes"
    string marketbreak_value
    decimal viewers_000
    decimal viewers_with_trait_000
    decimal comp_pct
    int respondent_count
  }
  dim_viewing_stream {
    string stream_code PK
    string time_shifted_viewing_type "Live, Live+SD, Live+3, Live+7"
    string nielsen_data_type "program or ACM"
    boolean is_commercial
    int days_credited
  }
  dim_network {
    bigint network_key PK
    date effective_from PK
    string network_name
    string display_name "from ref_network_wbd_attributes"
