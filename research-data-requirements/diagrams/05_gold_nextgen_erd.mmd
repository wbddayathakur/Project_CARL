  ngr_fct_avg_audience_month {
    int broadcast_month_key FK
    bigint network_key FK
    string demo_code FK
    bigint daypart_key FK
    string stream_code FK
    string viewing_methodology
    decimal avg_audience_000 "duration-weighted"
    decimal aa_minutes_numerator "for Cube re-weighting"
    int minutes
    decimal put_total_000
    decimal put_asco_000
    decimal coverage_rating
    decimal ue_cov_000
    decimal male_avg_audience_000
    decimal female_avg_audience_000
