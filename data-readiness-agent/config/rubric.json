{
  "status": "PROPOSED",
  "note": "There is no agreed definition of bronze/silver/gold readiness at WBD today (raised in the 30 Sep CARL/Iceberg leadership review). This file is a starting proposal so the scorer has something explicit to test against. Every criterion below can be edited, removed or promoted by the data owners. Criteria whose evidence is 'none' cannot be assessed from any data this PoC has; they are reported as UNVERIFIED, never guessed.",

  "fresh_window_days": 14,
  "recurring_min_commit_days_30d": 2,

  "criteria": [
    {"id": "B1", "layer": "bronze", "title": "Landed in dev", "evidence": "glue"},
    {"id": "B2", "layer": "bronze", "title": "Promoted to prod", "evidence": "glue"},
    {"id": "B3", "layer": "bronze", "title": "Updated in prod within the freshness window", "evidence": "glue"},
    {"id": "B4", "layer": "bronze", "title": "Loads recur in prod (not a one-time load)", "evidence": "load_history"},
    {"id": "B5", "layer": "bronze", "title": "Schema contract enforced (nullability, decimals preserved)", "evidence": "none", "needs": "Source-vs-bronze schema diff results (cf. CARL-3556)"},
    {"id": "B6", "layer": "bronze", "title": "Complete against the source system's table list", "evidence": "none", "needs": "A manifest of expected source tables and row counts"},

    {"id": "S1", "layer": "silver", "title": "Exists in dev", "evidence": "glue"},
    {"id": "S2", "layer": "silver", "title": "Promoted to prod", "evidence": "glue"},
    {"id": "S3", "layer": "silver", "title": "Updated in prod within the freshness window", "evidence": "glue"},
    {"id": "S4", "layer": "silver", "title": "Loads recur in prod (not a one-time load)", "evidence": "load_history"},
    {"id": "S5", "layer": "silver", "title": "Join integrity verified (match rate, orphan rate)", "evidence": "none", "needs": "Join-verification results (cf. CARL-4177)"},
    {"id": "S6", "layer": "silver", "title": "Data-quality rule results are logged", "evidence": "none", "needs": "Rows in a DQ results table (a dq_metrics database exists in dev only)"},

    {"id": "G1", "layer": "gold", "title": "Exists in dev", "evidence": "glue"},
    {"id": "G2", "layer": "gold", "title": "Promoted to prod", "evidence": "glue"},
    {"id": "G3", "layer": "gold", "title": "Updated in prod within the freshness window", "evidence": "glue"},
    {"id": "G4", "layer": "gold", "title": "Business definition documented and owned", "evidence": "none", "needs": "A data-product registry entry with owner and grain"},
    {"id": "G5", "layer": "gold", "title": "Parity with legacy output verified", "evidence": "none", "needs": "Parity-harness results (cf. CARL-4128)"},
    {"id": "G6", "layer": "gold", "title": "A golden / eval dataset exists for it", "evidence": "none", "needs": "A golden-dataset location and naming convention"}
  ],

